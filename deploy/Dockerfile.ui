FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY deploy/requirements-ui.txt ./requirements-ui.txt
RUN python -m pip install --no-cache-dir -r requirements-ui.txt
COPY ui.py ./ui.py
COPY .streamlit ./.streamlit
RUN useradd --system --uid 10001 --home-dir /app appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8501
CMD ["streamlit", "run", "ui.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
