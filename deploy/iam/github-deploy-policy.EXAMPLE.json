{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginToEcr",
      "Effect": "Allow",
      "Action": ["ecr:GetAuthorizationToken"],
      "Resource": "*"
    },
    {
      "Sid": "PushOnlyApprovedRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability", "ecr:InitiateLayerUpload", "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-2:REPLACE_ACCOUNT_ID:repository/studypilot-api",
        "arn:aws:ecr:eu-west-2:REPLACE_ACCOUNT_ID:repository/studypilot-ui"
      ]
    },
    {
      "Sid": "ReadCurrentDeployment",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:DescribeTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "RegisterNewTaskRevision",
      "Effect": "Allow",
      "Action": ["ecs:RegisterTaskDefinition"],
      "Resource": "*"
    },
    {
      "Sid": "UpdateOnlyStudyPilotServices",
      "Effect": "Allow",
      "Action": ["ecs:UpdateService"],
      "Resource": [
        "arn:aws:ecs:eu-west-2:REPLACE_ACCOUNT_ID:service/REPLACE_CLUSTER_NAME/REPLACE_API_SERVICE_NAME",
        "arn:aws:ecs:eu-west-2:REPLACE_ACCOUNT_ID:service/REPLACE_CLUSTER_NAME/REPLACE_UI_SERVICE_NAME"
      ]
    },
    {
      "Sid": "PassOnlyTaskRoles",
      "Effect": "Allow",
      "Action": ["iam:PassRole"],
      "Resource": ["REPLACE_EXECUTION_ROLE_ARN", "REPLACE_TASK_ROLE_ARN"],
      "Condition": {"StringEquals": {"iam:PassedToService": "ecs-tasks.amazonaws.com"}}
    }
  ]
}
