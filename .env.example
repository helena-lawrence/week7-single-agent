# Copy to .env. Change values locally; never commit .env.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Phase 3: requires Qdrant, embedding model and python ingest_notes.py
RETRIEVAL_MODE=keyword
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ai_study_notes
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QDRANT_API_KEY= (for managed Qdrant only)

# Phase 5/8: set a unique random key, not a company AWS secret
AGENT_API_KEY=replace-with-a-long-random-string
API_URL=http://localhost:8000

# Phase 6: use an approved Bedrock model or inference profile
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=

# Phase 7: optional; configure only if approved for sending trace contents
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
